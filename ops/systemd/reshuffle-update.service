@MANAGED_MARKER@
[Unit]
Description=DeShuffle manual update from main with backup and checks
Wants=network-online.target
After=network-online.target docker.service

[Service]
Type=oneshot
User=root
ExecStart=@PYTHON@ @UPDATER@ --config @CONFIG@
UMask=0077
TimeoutStartSec=infinity
KillMode=control-group
StandardOutput=journal
StandardError=journal
SyslogIdentifier=reshuffle-update
