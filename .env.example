# Required
DISCORD_TOKEN=your_bot_token_here

# Optional: numeric role ID to use instead of RELIABLE_ROLE_NAME in code
RELIABLE_ROLE_ID=

# Optional: numeric role ID to use instead of TRUSTED_ROLE_NAME in code
TRUSTED_ROLE_ID=

# Optional: directory for runtime data files (SQLite + JSON state)
# Docker image/compose default: /data
RESHUFFLE_DATA_DIR=

# Optional: path to editable JSON question list
# Default: questions.json inside RESHUFFLE_DATA_DIR
QUESTION_BANK_FILE=

# Optional book club extension. Enable, then run /club setup as a server administrator.
BOOKCLUB_ENABLED=false
# Leave empty for automatic setup with settings persisted in SQLite.
# Optional manual configuration: copy bookclub.example.json and fill channel/role IDs.
# Windows example: A:/path/to/bookclub.json; Docker example: /data/bookclub.json
BOOKCLUB_CONFIG_FILE=

# Optional temporary archive importer using Codex CLI on the bot machine.
# Copy bookclub.import.example.json to bookclub.import.json, fill the allowlists,
# and set enabled=true there. Changes take effect only after a bot restart.
# Leave empty to keep the importer disabled. Requires BOOKCLUB_ENABLED=true.
# Docker example: /data/bookclub.import.json
BOOKCLUB_IMPORT_CONFIG_FILE=
